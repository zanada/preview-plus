{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Package & Install Aseprite Extension",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "../build-extension.ps1",
        "-ExtensionDir",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}